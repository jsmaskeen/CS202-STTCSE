digraph ControlFlowGraph {
    node [shape=box, fontname="Courier"];
    edge [fontname="Helvetica"];
    B0 [label="B0\n\lprintf(\"\\n\\n\");\lprintf(\"*************************************************************\\n\");\lprintf(\"**      Discrete Fourier Transform Calculation Program     **\\n\");\lprintf(\"*************************************************************\\n\");\ldouble complex in[] = \{2.0, 3.0, 5.0, 7.0, 11.0\};\lconst size_t n = sizeof(in) / sizeof(in[0]);\ldouble complex out[n];\lconst double epsilon = 1e-14;\lprintf(\"--- Displaying Initial Input Signal ---\\n\\n\");\lprintf(\"Input array:\\n\");\lprintf(\"[\");\l"];
    B1 [label="B1\n\lfor (size_t i = 0; i < n; ++i)\l"];
    B2 [label="B2\n\lif (i != 0)\l"];
    B3 [label="B3\n\lprintf(\", \");\l"];
    B4 [label="B4\n\ldouble current_real_part;\ldouble current_imag_part;\lcurrent_real_part = creal(in[i]);\lcurrent_imag_part = cimag(in[i]);\l"];
    B5 [label="B5\n\lif (current_imag_part == 0)\l"];
    B6 [label="B6\n\lprintf(\"%f\", current_real_part);\l"];
    B7 [label="B7\n\l\l"];
    B8 [label="B8\n\lif (current_imag_part > 0)\l"];
    B9 [label="B9\n\lprintf(\"%f+%fi\", current_real_part, current_imag_part);\l"];
    B10 [label="B10\n\l\l"];
    B11 [label="B11\n\lprintf(\"%f%fi\", current_real_part, current_imag_part);\l"];
    B12 [label="B12\n\lprintf(\"]\\n\\n\");\lprintf(\"--- Beginning Forward Discrete Fourier Transform (DFT) ---\\n\\n\");\ldouble two_pi_val;\ldouble neg_two_pi_val;\ldouble n_as_double_dft;\ldouble f;\ltwo_pi_val = 2.0 * M_PI;\lneg_two_pi_val = -1.0 * two_pi_val;\ln_as_double_dft = (double)n;\lf = neg_two_pi_val / n_as_double_dft;\l"];
    B13 [label="B13\n\lfor (size_t i = 0; i < n; ++i)\l"];
    B14 [label="B14\n\ldouble complex sum = 0.0 + 0.0 * I;\l"];
    B15 [label="B15\n\lfor (size_t j = 0; j < n; ++j)\l"];
    B16 [label="B16\n\ldouble angle_i_component;\ldouble angle_j_component;\ldouble angle_product;\ldouble final_angle_x;\ldouble cos_of_x;\ldouble sin_of_x;\langle_i_component = (double)i;\langle_j_component = (double)j;\langle_product = f * angle_i_component;\lfinal_angle_x = angle_product * angle_j_component;\lcos_of_x = cos(final_angle_x);\lsin_of_x = sin(final_angle_x);\ldouble complex exponential_term;\lexponential_term = cos_of_x + sin_of_x * I;\ldouble complex input_sample;\linput_sample = in[j];\ldouble complex term_to_add;\lterm_to_add = input_sample * exponential_term;\lsum += term_to_add;\l"];
    B17 [label="B17\n\ldouble real_part_before_clean;\ldouble imag_part_before_clean;\lreal_part_before_clean = creal(sum);\limag_part_before_clean = cimag(sum);\ldouble rounded_real_part;\ldouble rounded_imag_part;\lrounded_real_part = round(real_part_before_clean);\lrounded_imag_part = round(imag_part_before_clean);\ldouble real_difference;\ldouble imag_difference;\lreal_difference = fabs(real_part_before_clean - rounded_real_part);\limag_difference = fabs(imag_part_before_clean - rounded_imag_part);\ldouble final_real_part = real_part_before_clean;\ldouble final_imag_part = imag_part_before_clean;\l"];
    B18 [label="B18\n\lif (real_difference < epsilon)\l"];
    B19 [label="B19\n\lfinal_real_part = rounded_real_part;\l"];
    B20 [label="B20\n\lif (imag_difference < epsilon)\l"];
    B21 [label="B21\n\lfinal_imag_part = rounded_imag_part;\l"];
    B22 [label="B22\n\ldouble complex cleaned_value;\lcleaned_value = final_real_part + final_imag_part * I;\lout[i] = cleaned_value;\l"];
    B23 [label="B23\n\lprintf(\"--- Forward DFT Complete. Displaying Result ---\\n\\n\");\lprintf(\"Discrete Fourier Transform:\\n\");\lprintf(\"[\");\l"];
    B24 [label="B24\n\lfor (size_t i = 0; i < n; ++i)\l"];
    B25 [label="B25\n\lif (i != 0)\l"];
    B26 [label="B26\n\lprintf(\", \");\l"];
    B27 [label="B27\n\ldouble r_dft;\ldouble im_dft;\lr_dft = creal(out[i]);\lim_dft = cimag(out[i]);\l"];
    B28 [label="B28\n\lif (im_dft == 0)\l"];
    B29 [label="B29\n\lprintf(\"%f\", r_dft);\l"];
    B30 [label="B30\n\l\l"];
    B31 [label="B31\n\lif (im_dft > 0)\l"];
    B32 [label="B32\n\lprintf(\"%f+%fi\", r_dft, im_dft);\l"];
    B33 [label="B33\n\l\l"];
    B34 [label="B34\n\lprintf(\"%f%fi\", r_dft, im_dft);\l"];
    B35 [label="B35\n\lprintf(\"]\\n\\n\");\lprintf(\"--- Beginning Inverse Discrete Fourier Transform (IDFT) ---\\n\\n\");\ldouble pos_two_pi_val;\ldouble n_as_double_idft;\ldouble f_inverse;\lpos_two_pi_val = 2.0 * M_PI;\ln_as_double_idft = (double)n;\lf_inverse = pos_two_pi_val / n_as_double_idft;\l"];
    B36 [label="B36\n\lfor (size_t i = 0; i < n; ++i)\l"];
    B37 [label="B37\n\ldouble complex inv_sum = 0.0 + 0.0 * I;\l"];
    B38 [label="B38\n\lfor (size_t j = 0; j < n; ++j)\l"];
    B39 [label="B39\n\ldouble inv_angle_i_comp;\ldouble inv_angle_j_comp;\ldouble inv_angle_prod;\ldouble final_inv_angle_x;\ldouble inv_cos_x;\ldouble inv_sin_x;\linv_angle_i_comp = (double)i;\linv_angle_j_comp = (double)j;\linv_angle_prod = f_inverse * inv_angle_i_comp;\lfinal_inv_angle_x = inv_angle_prod * inv_angle_j_comp;\linv_cos_x = cos(final_inv_angle_x);\linv_sin_x = sin(final_inv_angle_x);\ldouble complex inv_exp_term;\linv_exp_term = inv_cos_x + inv_sin_x * I;\ldouble complex dft_sample;\ldft_sample = out[j];\ldouble complex inv_term_to_add;\linv_term_to_add = dft_sample * inv_exp_term;\linv_sum += inv_term_to_add;\l"];
    B40 [label="B40\n\ldouble complex scaled_sum;\lscaled_sum = inv_sum / n_as_double_idft;\ldouble inv_real_before_clean;\ldouble inv_imag_before_clean;\linv_real_before_clean = creal(scaled_sum);\linv_imag_before_clean = cimag(scaled_sum);\ldouble inv_rounded_real;\ldouble inv_rounded_imag;\linv_rounded_real = round(inv_real_before_clean);\linv_rounded_imag = round(inv_imag_before_clean);\ldouble inv_real_diff;\ldouble inv_imag_diff;\linv_real_diff = fabs(inv_real_before_clean - inv_rounded_real);\linv_imag_diff = fabs(inv_imag_before_clean - inv_rounded_imag);\ldouble inv_final_real = inv_real_before_clean;\ldouble inv_final_imag = inv_imag_before_clean;\l"];
    B41 [label="B41\n\lif (inv_real_diff < epsilon)\l"];
    B42 [label="B42\n\linv_final_real = inv_rounded_real;\l"];
    B43 [label="B43\n\lif (inv_imag_diff < epsilon)\l"];
    B44 [label="B44\n\linv_final_imag = inv_rounded_imag;\l"];
    B45 [label="B45\n\ldouble complex inv_cleaned_value;\linv_cleaned_value = inv_final_real + inv_final_imag * I;\lin[i] = inv_cleaned_value;\l"];
    B46 [label="B46\n\lprintf(\"--- Inverse DFT Complete. Displaying Final Reconstructed Signal ---\\n\\n\");\lprintf(\"Inverse DFT:\\n\");\lprintf(\"[\");\l"];
    B47 [label="B47\n\lfor (size_t i = 0; i < n; ++i)\l"];
    B48 [label="B48\n\lif (i != 0)\l"];
    B49 [label="B49\n\lprintf(\", \");\l"];
    B50 [label="B50\n\ldouble r_idft;\ldouble im_idft;\lr_idft = creal(in[i]);\lim_idft = cimag(in[i]);\l"];
    B51 [label="B51\n\lif (im_idft == 0)\l"];
    B52 [label="B52\n\lprintf(\"%f\", r_idft);\l"];
    B53 [label="B53\n\l\l"];
    B54 [label="B54\n\lif (im_idft > 0)\l"];
    B55 [label="B55\n\lprintf(\"%f+%fi\", r_idft, im_idft);\l"];
    B56 [label="B56\n\l\l"];
    B57 [label="B57\n\lprintf(\"%f%fi\", r_idft, im_idft);\l"];
    B58 [label="B58\n\lprintf(\"]\\n\\n\");\lprintf(\"--- Program Finished ---\\n\");\lprintf(\"All calculations are complete. Exiting.\\n\\n\");\lreturn 0;\l"];
    B0 -> B1;
    B1 -> B2 [label="true"];
    B1 -> B12 [label="false"];
    B2 -> B3 [label="true"];
    B2 -> B4 [label="false"];
    B3 -> B4;
    B4 -> B5;
    B5 -> B6 [label="true"];
    B5 -> B8 [label="false"];
    B6 -> B7;
    B7 -> B1;
    B8 -> B9 [label="true"];
    B8 -> B11 [label="false"];
    B9 -> B10;
    B10 -> B7;
    B11 -> B10;
    B12 -> B13;
    B13 -> B14 [label="true"];
    B13 -> B23 [label="false"];
    B14 -> B15;
    B15 -> B16 [label="true"];
    B15 -> B17 [label="false"];
    B16 -> B15;
    B17 -> B18;
    B18 -> B19 [label="true"];
    B18 -> B20 [label="false"];
    B19 -> B20;
    B20 -> B21 [label="true"];
    B20 -> B22 [label="false"];
    B21 -> B22;
    B22 -> B13;
    B23 -> B24;
    B24 -> B25 [label="true"];
    B24 -> B35 [label="false"];
    B25 -> B26 [label="true"];
    B25 -> B27 [label="false"];
    B26 -> B27;
    B27 -> B28;
    B28 -> B29 [label="true"];
    B28 -> B31 [label="false"];
    B29 -> B30;
    B30 -> B24;
    B31 -> B32 [label="true"];
    B31 -> B34 [label="false"];
    B32 -> B33;
    B33 -> B30;
    B34 -> B33;
    B35 -> B36;
    B36 -> B37 [label="true"];
    B36 -> B46 [label="false"];
    B37 -> B38;
    B38 -> B39 [label="true"];
    B38 -> B40 [label="false"];
    B39 -> B38;
    B40 -> B41;
    B41 -> B42 [label="true"];
    B41 -> B43 [label="false"];
    B42 -> B43;
    B43 -> B44 [label="true"];
    B43 -> B45 [label="false"];
    B44 -> B45;
    B45 -> B36;
    B46 -> B47;
    B47 -> B48 [label="true"];
    B47 -> B58 [label="false"];
    B48 -> B49 [label="true"];
    B48 -> B50 [label="false"];
    B49 -> B50;
