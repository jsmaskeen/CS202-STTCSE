digraph ControlFlowGraph {
    node [shape=box, fontname="Courier"];
    edge [fontname="Helvetica"];
    B0 [label="B0\n\lint gameIsActive = 1;\lint hasPlayerWon = 0;\lint playerLocation = 0;\lint playerHealth = 100;\lint inventory[10] = \{0\};\lconst int ITEM_TORCH = 0;\lconst int ITEM_SWORD = 1;\lconst int ITEM_SHIELD = 2;\lconst int ITEM_KEY = 3;\lconst int ITEM_POTION = 4;\lconst char *itemNames[10] = \{\l\"a rusty torch\",\l\"a short sword\",\l\"a wooden shield\",\l\"an ornate key\",\l\"a healing potion\"\};\lint roomItems[10][10] = \{\{0\}\};\lint roomVisited[10] = \{0\};\lint puzzleSolved = 0;\lint exitUnlocked = 0;\lint hallwayTrapTriggered = 0;\lchar playerInput[100] = \{0\};\lchar command[50] = \{0\};\lchar argument[50] = \{0\};\lint inputIsValid = 0;\lint i = 0;\lconst int ROOM_CELL = 0;\lconst int ROOM_HALLWAY = 1;\lconst int ROOM_ARMORY = 2;\lconst int ROOM_STUDY = 3;\lconst int ROOM_CHAMBER = 4;\lconst int ROOM_GATE = 5;\lconst char *roomNames[10] = \{\l\"Starting Cell\",\l\"Echoing Hallway\",\l\"Ancient Armory\",\l\"Alchemist's Study\",\l\"Flooded Chamber\",\l\"The Grand Exit\"\};\lroomItems[ROOM_CELL][ITEM_TORCH] = 1;\lroomItems[ROOM_ARMORY][ITEM_SWORD] = 1;\lroomItems[ROOM_ARMORY][ITEM_SHIELD] = 1;\lroomItems[ROOM_STUDY][ITEM_POTION] = 1;\lprintf(\"--- The Lost Labyrinth of Lumina ---\\n\");\lprintf(\"You awaken on a cold, stone floor. It is pitch black.\\n\");\lprintf(\"A faint, damp smell hangs in the air.\\n\");\lprintf(\"What do you do? (Type 'help' for commands)\\n\\n\");\l"];
    B1 [label="B1\n\lwhile (gameIsActive == 1)\l"];
    B2 [label="B2\n\lcommand[0] = '\\0';\largument[0] = '\\0';\l"];
    B3 [label="B3\n\lif (playerLocation == ROOM_CELL)\l"];
    B4 [label="B4\n\lprintf(\"You are in a small, damp cell. The walls are slick with moisture.\\n\");\l"];
    B5 [label="B5\n\lif (inventory[ITEM_TORCH] == 0)\l"];
    B6 [label="B6\n\lprintf(\"It is too dark to see much, but you can feel a wooden door to the NORTH.\\n\");\l"];
    B7 [label="B7\n\lif (roomItems[ROOM_CELL][ITEM_TORCH] == 1)\l"];
    B8 [label="B8\n\lprintf(\"You fumble around on the floor and feel a TORCH.\\n\");\l"];
    B9 [label="B9\n\l\l"];
    B10 [label="B10\n\l\l"];
    B11 [label="B11\n\lprintf(\"Your torch illuminates the cramped space. There is a single wooden door to the NORTH.\\n\");\l"];
    B12 [label="B12\n\lif (roomVisited[playerLocation] == 0)\l"];
    B13 [label="B13\n\lif (playerLocation == ROOM_HALLWAY)\l"];
    B14 [label="B14\n\lprintf(\"You are in a long, echoing hallway. Torches in sconces cast flickering shadows.\\n\");\lprintf(\"The hallway continues to the NORTH. The cell is to the SOUTH.\\n\");\lprintf(\"There are doors to the EAST and WEST.\\n\");\l"];
    B15 [label="B15\n\l\l"];
    B16 [label="B16\n\lif (playerLocation == ROOM_ARMORY)\l"];
    B17 [label="B17\n\lprintf(\"You have entered an old armory. Racks of rusted weapons line the walls.\\n\");\l"];
    B18 [label="B18\n\lif (roomItems[ROOM_ARMORY][ITEM_SWORD] == 1 || roomItems[ROOM_ARMORY][ITEM_SHIELD] == 1)\l"];
    B19 [label="B19\n\lprintf(\"On a dusty table, you see a SWORD and a SHIELD.\\n\");\l"];
    B20 [label="B20\n\lprintf(\"The only exit is back to the hallway to the EAST.\\n\");\l"];
    B21 [label="B21\n\l\l"];
    B22 [label="B22\n\lif (playerLocation == ROOM_STUDY)\l"];
    B23 [label="B23\n\lprintf(\"This room is clearly an alchemist's study. Broken vials and strange powders litter the floor.\\n\");\l"];
    B24 [label="B24\n\lif (puzzleSolved == 0)\l"];
    B25 [label="B25\n\lprintf(\"A single SCROLL sits on a stone lectern in the center of the room.\\n\");\l"];
    B26 [label="B26\n\lif (roomItems[ROOM_STUDY][ITEM_POTION] == 1)\l"];
    B27 [label="B27\n\lprintf(\"A small, corked POTION sits on a shelf.\\n\");\l"];
    B28 [label="B28\n\lprintf(\"The only way out is to the WEST.\\n\");\l"];
    B29 [label="B29\n\l\l"];
    B30 [label="B30\n\lif (playerLocation == ROOM_CHAMBER)\l"];
    B31 [label="B31\n\lprintf(\"This chamber is flooded with knee-deep, murky water. The air is heavy and cold.\\n\");\l"];
    B32 [label="B32\n\lif (puzzleSolved == 1 && roomItems[ROOM_CHAMBER][ITEM_KEY] == 1)\l"];
    B33 [label="B33\n\lprintf(\"You see the glint of a KEY at the bottom of the water.\\n\");\l"];
    B34 [label="B34\n\lprintf(\"The hallway lies to the SOUTH.\\n\");\l"];
    B35 [label="B35\n\l\l"];
    B36 [label="B36\n\lif (playerLocation == ROOM_GATE)\l"];
    B37 [label="B37\n\lprintf(\"You stand before a massive, iron-wrought gate. It is covered in intricate, ancient designs.\\n\");\lprintf(\"It appears to be the only way out. It is firmly locked.\\n\");\lprintf(\"The hallway is to the SOUTH.\\n\");\l"];
    B38 [label="B38\n\l\l"];
    B39 [label="B39\n\lroomVisited[playerLocation] = 1;\l"];
    B40 [label="B40\n\lif (playerLocation == ROOM_HALLWAY && hallwayTrapTriggered == 0)\l"];
    B41 [label="B41\n\lhallwayTrapTriggered = 1;\lprintf(\"\\n>> As you step into the center of the hall, you hear a *click*! <<\\n\");\lprintf(\">> Arrows shoot from hidden slits in the walls! <<\\n\");\l"];
    B42 [label="B42\n\lif (inventory[ITEM_SHIELD] == 1)\l"];
    B43 [label="B43\n\lplayerHealth = playerHealth - 15;\lprintf(\">> You raise your shield just in time, but one arrow gets through! You lose 15 health. <<\\n\");\l"];
    B44 [label="B44\n\lprintf(\"Your health is now %d.\\n\\n\", playerHealth);\l"];
    B45 [label="B45\n\lplayerHealth = playerHealth - 40;\lprintf(\">> With nothing to defend yourself, several arrows strike you! You lose 40 health. <<\\n\");\l"];
    B46 [label="B46\n\linputIsValid = 0;\l"];
    B47 [label="B47\n\lwhile (inputIsValid == 0)\l"];
    B48 [label="B48\n\lprintf(\"> \");\l"];
    B49 [label="B49\n\lif (fgets(playerInput, sizeof(playerInput), stdin) != NULL)\l"];
    B50 [label="B50\n\lfor (i = 0; playerInput[i] != '\\0'; i++)\l"];
    B51 [label="B51\n\lplayerInput[i] = tolower(playerInput[i]);\l"];
    B52 [label="B52\n\lif (sscanf(playerInput, \"%s %s\", command, argument) >= 1)\l"];
    B53 [label="B53\n\linputIsValid = 1;\l"];
    B54 [label="B54\n\l\l"];
    B55 [label="B55\n\lprintf(\"Please enter a valid command.\\n\");\l"];
    B56 [label="B56\n\l\l"];
    B57 [label="B57\n\lprintf(\"\\n\");\l"];
    B58 [label="B58\n\lif (strcmp(command, \"quit\") == 0)\l"];
    B59 [label="B59\n\lgameIsActive = 0;\lprintf(\"You give up and accept your fate in the darkness.\\n\");\l"];
    B60 [label="B60\n\lif (playerHealth <= 0)\l"];
    B61 [label="B61\n\lif (strcmp(command, \"help\") == 0)\l"];
    B62 [label="B62\n\lprintf(\"Commands:\\n\");\lprintf(\"  go [north|south|east|west]\\n\");\lprintf(\"  take [item]\\n\");\lprintf(\"  use [item]\\n\");\lprintf(\"  examine [object]\\n\");\lprintf(\"  answer [solution]\\n\");\lprintf(\"  inventory\\n\");\lprintf(\"  health\\n\");\lprintf(\"  quit\\n\\n\");\l"];
    B63 [label="B63\n\l\l"];
    B64 [label="B64\n\lif (strcmp(command, \"inventory\") == 0)\l"];
    B65 [label="B65\n\lprintf(\"You are carrying:\\n\");\lint hasItems = 0;\l"];
    B66 [label="B66\n\lfor (i = 0; i < 10; i++)\l"];
    B67 [label="B67\n\lif (inventory[i] == 1)\l"];
    B68 [label="B68\n\lprintf(\" - %s\\n\", itemNames[i]);\lhasItems = 1;\l"];
    B69 [label="B69\n\l\l"];
    B70 [label="B70\n\lif (hasItems == 0)\l"];
    B71 [label="B71\n\lprintf(\" - Nothing.\\n\");\l"];
    B72 [label="B72\n\lprintf(\"\\n\");\l"];
    B73 [label="B73\n\l\l"];
    B74 [label="B74\n\lif (strcmp(command, \"health\") == 0)\l"];
    B75 [label="B75\n\lprintf(\"Your current health is: %d/100.\\n\\n\", playerHealth);\l"];
    B76 [label="B76\n\l\l"];
    B77 [label="B77\n\lif (strcmp(command, \"go\") == 0)\l"];
    B78 [label="B78\n\lint moved = 0;\l"];
    B79 [label="B79\n\lif (playerLocation == ROOM_CELL)\l"];
    B80 [label="B80\n\lif (strcmp(argument, \"north\") == 0)\l"];
    B81 [label="B81\n\lplayerLocation = ROOM_HALLWAY;\lmoved = 1;\l"];
    B82 [label="B82\n\l\l"];
    B83 [label="B83\n\lif (moved == 0)\l"];
    B84 [label="B84\n\lif (playerLocation == ROOM_HALLWAY)\l"];
    B85 [label="B85\n\lif (strcmp(argument, \"north\") == 0)\l"];
    B86 [label="B86\n\lplayerLocation = ROOM_GATE;\lmoved = 1;\l"];
    B87 [label="B87\n\l\l"];
    B88 [label="B88\n\lif (strcmp(argument, \"south\") == 0)\l"];
    B89 [label="B89\n\lplayerLocation = ROOM_CELL;\lmoved = 1;\l"];
    B90 [label="B90\n\l\l"];
    B91 [label="B91\n\lif (strcmp(argument, \"east\") == 0)\l"];
    B92 [label="B92\n\lplayerLocation = ROOM_STUDY;\lmoved = 1;\l"];
    B93 [label="B93\n\l\l"];
    B94 [label="B94\n\lif (strcmp(argument, \"west\") == 0)\l"];
    B95 [label="B95\n\lplayerLocation = ROOM_ARMORY;\lmoved = 1;\l"];
    B96 [label="B96\n\l\l"];
    B97 [label="B97\n\l\l"];
    B98 [label="B98\n\lif (playerLocation == ROOM_ARMORY)\l"];
    B99 [label="B99\n\lif (strcmp(argument, \"east\") == 0)\l"];
    B100 [label="B100\n\lplayerLocation = ROOM_HALLWAY;\lmoved = 1;\l"];
    B101 [label="B101\n\l\l"];
    B102 [label="B102\n\l\l"];
    B103 [label="B103\n\lif (playerLocation == ROOM_STUDY)\l"];
    B104 [label="B104\n\lif (strcmp(argument, \"west\") == 0)\l"];
    B105 [label="B105\n\lplayerLocation = ROOM_HALLWAY;\lmoved = 1;\l"];
    B106 [label="B106\n\l\l"];
    B107 [label="B107\n\l\l"];
    B108 [label="B108\n\lif (playerLocation == ROOM_CHAMBER)\l"];
    B109 [label="B109\n\lif (strcmp(argument, \"south\") == 0)\l"];
    B110 [label="B110\n\lplayerLocation = ROOM_HALLWAY;\lmoved = 1;\l"];
    B111 [label="B111\n\l\l"];
    B112 [label="B112\n\l\l"];
    B113 [label="B113\n\lif (playerLocation == ROOM_GATE)\l"];
    B114 [label="B114\n\lif (strcmp(argument, \"south\") == 0)\l"];
    B115 [label="B115\n\lplayerLocation = ROOM_HALLWAY;\lmoved = 1;\l"];
    B116 [label="B116\n\l\l"];
    B117 [label="B117\n\l\l"];
    B118 [label="B118\n\lprintf(\"You can't go that way.\\n\\n\");\l"];
    B119 [label="B119\n\l\l"];
    B120 [label="B120\n\l\l"];
    B121 [label="B121\n\lif (strcmp(command, \"take\") == 0)\l"];
    B122 [label="B122\n\lint itemTaken = 0;\l"];
    B123 [label="B123\n\lif (playerLocation == ROOM_CELL && strcmp(argument, \"torch\") == 0)\l"];
    B124 [label="B124\n\lif (roomItems[ROOM_CELL][ITEM_TORCH] == 1)\l"];
    B125 [label="B125\n\linventory[ITEM_TORCH] = 1;\lroomItems[ROOM_CELL][ITEM_TORCH] = 0;\litemTaken = 1;\lprintf(\"You now have a torch. The darkness recedes.\\n\\n\");\l"];
    B126 [label="B126\n\l\l"];
    B127 [label="B127\n\lif (itemTaken == 0)\l"];
    B128 [label="B128\n\lif (playerLocation == ROOM_ARMORY)\l"];
    B129 [label="B129\n\lif (strcmp(argument, \"sword\") == 0 && roomItems[ROOM_ARMORY][ITEM_SWORD] == 1)\l"];
    B130 [label="B130\n\linventory[ITEM_SWORD] = 1;\lroomItems[ROOM_ARMORY][ITEM_SWORD] = 0;\litemTaken = 1;\lprintf(\"You take the short sword.\\n\\n\");\l"];
    B131 [label="B131\n\l\l"];
    B132 [label="B132\n\lif (strcmp(argument, \"shield\") == 0 && roomItems[ROOM_ARMORY][ITEM_SHIELD] == 1)\l"];
    B133 [label="B133\n\linventory[ITEM_SHIELD] = 1;\lroomItems[ROOM_ARMORY][ITEM_SHIELD] = 0;\litemTaken = 1;\lprintf(\"You pick up the wooden shield.\\n\\n\");\l"];
    B134 [label="B134\n\l\l"];
    B135 [label="B135\n\l\l"];
    B136 [label="B136\n\lif (playerLocation == ROOM_STUDY && strcmp(argument, \"potion\") == 0)\l"];
    B137 [label="B137\n\lif (roomItems[ROOM_STUDY][ITEM_POTION] == 1)\l"];
    B138 [label="B138\n\linventory[ITEM_POTION] = 1;\lroomItems[ROOM_STUDY][ITEM_POTION] = 0;\litemTaken = 1;\lprintf(\"You took the healing potion.\\n\\n\");\l"];
    B139 [label="B139\n\l\l"];
    B140 [label="B140\n\l\l"];
    B141 [label="B141\n\lif (playerLocation == ROOM_CHAMBER && strcmp(argument, \"key\") == 0)\l"];
    B142 [label="B142\n\lif (roomItems[ROOM_CHAMBER][ITEM_KEY] == 1)\l"];
    B143 [label="B143\n\linventory[ITEM_KEY] = 1;\lroomItems[ROOM_CHAMBER][ITEM_KEY] = 0;\litemTaken = 1;\lprintf(\"You reach into the cold water and retrieve the ornate key.\\n\\n\");\l"];
    B144 [label="B144\n\l\l"];
    B145 [label="B145\n\l\l"];
    B146 [label="B146\n\lprintf(\"You can't take that.\\n\\n\");\l"];
    B147 [label="B147\n\l\l"];
    B148 [label="B148\n\l\l"];
    B149 [label="B149\n\lif (strcmp(command, \"examine\") == 0 || strcmp(command, \"read\") == 0)\l"];
    B150 [label="B150\n\lif (playerLocation == ROOM_STUDY && strcmp(argument, \"scroll\") == 0)\l"];
    B151 [label="B151\n\lprintf(\"The scroll is old and brittle. It reads:\\n\");\lprintf(\"  'I have cities, but no houses.\\n\");\lprintf(\"   I have mountains, but no trees.\\n\");\lprintf(\"   I have water, but no fish.\\n\");\lprintf(\"   What am I?'\\n\\n\");\lprintf(\"Type 'answer [your_guess]' to solve.\\n\\n\");\l"];
    B152 [label="B152\n\l\l"];
    B153 [label="B153\n\lprintf(\"There is nothing special to examine.\\n\\n\");\l"];
    B154 [label="B154\n\l\l"];
    B155 [label="B155\n\lif (strcmp(command, \"answer\") == 0)\l"];
    B156 [label="B156\n\lif (playerLocation == ROOM_STUDY)\l"];
    B157 [label="B157\n\lif (strcmp(argument, \"map\") == 0)\l"];
    B158 [label="B158\n\lif (puzzleSolved == 0)\l"];
    B159 [label="B159\n\lpuzzleSolved = 1;\lroomItems[ROOM_CHAMBER][ITEM_KEY] = 1;\lprintf(\"Correct! As you speak the word, you hear a faint *plink* from a room to the north.\\n\\n\");\l"];
    B160 [label="B160\n\l\l"];
    B161 [label="B161\n\lprintf(\"You have already solved this riddle.\\n\\n\");\l"];
    B162 [label="B162\n\l\l"];
    B163 [label="B163\n\lprintf(\"That is not the correct answer.\\n\\n\");\l"];
    B164 [label="B164\n\l\l"];
    B165 [label="B165\n\lprintf(\"There is nothing to answer here.\\n\\n\");\l"];
    B166 [label="B166\n\l\l"];
    B167 [label="B167\n\lif (strcmp(command, \"use\") == 0)\l"];
    B168 [label="B168\n\lif (strcmp(argument, \"potion\") == 0)\l"];
    B169 [label="B169\n\lif (inventory[ITEM_POTION] == 1)\l"];
    B170 [label="B170\n\lplayerHealth = playerHealth + 50;\l"];
    B171 [label="B171\n\lif (playerHealth > 100)\l"];
    B172 [label="B172\n\lplayerHealth = 100;\l"];
    B173 [label="B173\n\linventory[ITEM_POTION] = 0;\lprintf(\"You drink the potion. You feel a warm, healing sensation. Your health is now %d.\\n\\n\", playerHealth);\l"];
    B174 [label="B174\n\l\l"];
    B175 [label="B175\n\lprintf(\"You don't have a potion.\\n\\n\");\l"];
    B176 [label="B176\n\l\l"];
    B177 [label="B177\n\lif (strcmp(argument, \"key\") == 0)\l"];
    B178 [label="B178\n\lif (inventory[ITEM_KEY] == 1)\l"];
    B179 [label="B179\n\lif (playerLocation == ROOM_GATE)\l"];
    B180 [label="B180\n\lexitUnlocked = 1;\lprintf(\"You insert the ornate key into the massive lock. With a deafening *CRACK*, the tumblers turn and the gate is unlocked!\\n\\n\");\l"];
    B181 [label="B181\n\l\l"];
    B182 [label="B182\n\lprintf(\"This is not the place to use the key.\\n\\n\");\l"];
    B183 [label="B183\n\l\l"];
    B184 [label="B184\n\lprintf(\"You don't have a key.\\n\\n\");\l"];
    B185 [label="B185\n\l\l"];
    B186 [label="B186\n\lprintf(\"You can't use that.\\n\\n\");\l"];
    B187 [label="B187\n\l\l"];
    B188 [label="B188\n\lprintf(\"I don't understand that command. Type 'help' for a list of commands.\\n\\n\");\l"];
    B189 [label="B189\n\lgameIsActive = 0;\lhasPlayerWon = 0;\l"];
    B190 [label="B190\n\lif (exitUnlocked == 1 && playerLocation == ROOM_GATE)\l"];
    B191 [label="B191\n\lgameIsActive = 0;\lhasPlayerWon = 1;\l"];
    B192 [label="B192\n\l\l"];
    B193 [label="B193\n\lif (hasPlayerWon == 1)\l"];
    B194 [label="B194\n\lprintf(\"With a final, heroic push, the grand gate swings open, revealing a path to sunlight and freedom.\\n\");\lprintf(\"You have escaped the Labyrinth of Lumina!\\n\");\lprintf(\"CONGRATULATIONS!\\n\");\l"];
    B195 [label="B195\n\lreturn 0;\l"];
    B196 [label="B196\n\lprintf(\"\\nYour vision fades to black...\\n\");\lprintf(\"The labyrinth has claimed another soul.\\n\");\lprintf(\"GAME OVER\\n\");\l"];
