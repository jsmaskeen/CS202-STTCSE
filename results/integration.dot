    B24 -> B21;
    B25 -> B26;
    B26 -> B27 [label="true"];
    B26 -> B28 [label="false"];
    B27 -> B26;
    B28 -> B29;
    B29 -> B30 [label="true"];
    B29 -> B33 [label="false"];
    B30 -> B31 [label="true"];
    B30 -> B32 [label="false"];
    B31 -> B30;
