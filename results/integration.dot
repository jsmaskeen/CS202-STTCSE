    B53 -> B52;
    B54 -> B55;
    B55 -> B56 [label="true"];
    B55 -> B61 [label="false"];
    B56 -> B57 [label="true"];
    B56 -> B60 [label="false"];
    B57 -> B58 [label="true"];
    B57 -> B59 [label="false"];
