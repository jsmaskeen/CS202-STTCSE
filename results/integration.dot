    B16 -> B17 [label="true"];
    B16 -> B21 [label="false"];
    B17 -> B18;
    B18 -> B19 [label="true"];
    B18 -> B20 [label="false"];
    B19 -> B18;
    B20 -> B16;
    B21 -> B22 [label="true"];
    B21 -> B25 [label="false"];
    B22 -> B23 [label="true"];
    B22 -> B24 [label="false"];
