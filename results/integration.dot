digraph ControlFlowGraph {
    node [shape=box, fontname="Courier"];
    edge [fontname="Helvetica"];
    B0 [label="B0\n\lprintf(\"Numerical Integration and Related Computations\\n\");\lsrand(time(NULL));\lint i = 0;\lint j = 0;\lint k = 0;\lint n = 10000;\ldouble a = 0.0, b = M_PI;\ldouble h = (b - a) / n;\ldouble rect = 0.0, trap = 0.0, simp = 0.0;\l"];
    B1 [label="B1\n\li = 0;\l"];
    B2 [label="B2\n\lif (i < n)\l"];
    B3 [label="B3\n\lrect *= h;\l"];
    B4 [label="B4\n\li++;\l"];
    B5 [label="B5\n\ldouble x = a + i * h;\lrect += sin(x);\l"];
    B6 [label="B6\n\li = 0;\l"];
    B7 [label="B7\n\lif (i < n)\l"];
    B8 [label="B8\n\ltrap *= h;\l"];
    B9 [label="B9\n\li++;\l"];
    B10 [label="B10\n\ldouble x1 = a + i * h;\ldouble x2 = a + (i + 1) * h;\ltrap += 0.5 * (sin(x1) + sin(x2));\l"];
    B11 [label="B11\n\li = 0;\l"];
    B12 [label="B12\n\lif (i < n)\l"];
    B13 [label="B13\n\lsimp *= h / 3.0;\lprintf(\"Rect %.10f\\nTrap %.10f\\nSimp %.10f\\n\", rect, trap, simp);\ldouble monte = 0.0;\l"];
    B14 [label="B14\n\li += 2;\l"];
    B15 [label="B15\n\ldouble x0 = a + i * h;\ldouble x1 = a + (i + 1) * h;\ldouble x2 = a + (i + 2) * h;\lsimp += (sin(x0) + 4 * sin(x1) + sin(x2));\l"];
    B16 [label="B16\n\li = 0;\l"];
    B17 [label="B17\n\lif (i < n)\l"];
    B18 [label="B18\n\lmonte *= (b - a) / n;\lprintf(\"Monte %.10f\\n\", monte);\ldouble gauss = 0.0;\lint ng = 1000;\l"];
    B19 [label="B19\n\li++;\l"];
    B20 [label="B20\n\ldouble r = a + (b - a) * (rand() / (double)RAND_MAX);\lmonte += sin(r);\l"];
    B21 [label="B21\n\li = 0;\l"];
    B22 [label="B22\n\lif (i < ng)\l"];
    B23 [label="B23\n\lgauss *= (b - a) / ng;\lprintf(\"Gauss %.10f\\n\", gauss);\ldouble rom[8][8] = \{\{0.0\}\};\l"];
    B24 [label="B24\n\li++;\l"];
    B25 [label="B25\n\ldouble t = cos(M_PI * (i + 0.75) / (ng + 0.5));\lgauss += sin(0.5 * (b - a) * t + 0.5 * (b + a));\l"];
    B26 [label="B26\n\li = 0;\l"];
    B27 [label="B27\n\lif (i < 8)\l"];
    B28 [label="B28\n\li = 1;\l"];
    B29 [label="B29\n\li++;\l"];
    B30 [label="B30\n\lint m = 1 << i;\ldouble step = (b - a) / m;\ldouble s = 0.5 * (sin(a) + sin(b));\l"];
    B31 [label="B31\n\lj = 1;\l"];
    B32 [label="B32\n\lif (j < m)\l"];
    B33 [label="B33\n\lrom[i][0] = s * step;\l"];
    B34 [label="B34\n\lj++;\l"];
    B35 [label="B35\n\ls += sin(a + j * step);\l"];
    B36 [label="B36\n\lif (i < 8)\l"];
    B37 [label="B37\n\lprintf(\"Romberg %.10f\\n\", rom[7][7]);\ldouble integ = 0.0;\lint slices = 5000;\ldouble step = (b - a) / slices;\l"];
    B38 [label="B38\n\li++;\l"];
    B39 [label="B39\n\lj = 1;\l"];
    B40 [label="B40\n\lif (j <= i)\l"];
    B41 [label="B41\n\l\l"];
    B42 [label="B42\n\lj++;\l"];
    B43 [label="B43\n\lrom[i][j] = (pow(4, j) * rom[i][j - 1] - rom[i - 1][j - 1]) / (pow(4, j) - 1);\l"];
    B44 [label="B44\n\li = 0;\l"];
    B45 [label="B45\n\lif (i < slices)\l"];
    B46 [label="B46\n\linteg *= step;\lprintf(\"Gaussian exp(-x^2) %.10f\\n\", integ);\ldouble double_sum = 0.0;\lint m1 = 200, m2 = 200;\ldouble xa = 0, xb = 1, ya = 0, yb = 1;\ldouble hx = (xb - xa) / m1;\ldouble hy = (yb - ya) / m2;\l"];
    B47 [label="B47\n\li++;\l"];
    B48 [label="B48\n\ldouble x = a + i * step + step / 2.0;\linteg += exp(-x * x);\l"];
    B49 [label="B49\n\li = 0;\l"];
    B50 [label="B50\n\lif (i < m1)\l"];
    B51 [label="B51\n\ldouble_sum *= hx * hy;\lprintf(\"Double integral sin(xy) %.10f\\n\", double_sum);\ldouble volume = 0.0;\lint samples = 200000;\l"];
    B52 [label="B52\n\li++;\l"];
    B53 [label="B53\n\lj = 0;\l"];
    B54 [label="B54\n\lif (j < m2)\l"];
    B55 [label="B55\n\l\l"];
    B56 [label="B56\n\lj++;\l"];
    B57 [label="B57\n\ldouble x = xa + (i + 0.5) * hx;\ldouble y = ya + (j + 0.5) * hy;\ldouble_sum += sin(x * y);\l"];
    B58 [label="B58\n\li = 0;\l"];
    B59 [label="B59\n\lif (i < samples)\l"];
    B60 [label="B60\n\lvolume /= samples;\lvolume *= 8.0;\lprintf(\"Sphere volume %.10f\\n\", volume);\ldouble pi_est = 0.0;\lint hits = 0;\l"];
    B61 [label="B61\n\li++;\l"];
    B62 [label="B62\n\ldouble x = (double)rand() / RAND_MAX;\ldouble y = (double)rand() / RAND_MAX;\ldouble z = (double)rand() / RAND_MAX;\l"];
    B63 [label="B63\n\lif (x * x + y * y + z * z <= 1.0)\l"];
    B64 [label="B64\n\lvolume=volume+1;\l"];
    B65 [label="B65\n\l\l"];
    B66 [label="B66\n\li = 0;\l"];
    B67 [label="B67\n\lif (i < 500000)\l"];
    B68 [label="B68\n\lpi_est = 4.0 * hits / 500000.0;\lprintf(\"Monte Pi %.10f\\n\", pi_est);\ldouble taylor = 0.0;\ldouble xval = 1.0;\l"];
    B69 [label="B69\n\li++;\l"];
    B70 [label="B70\n\ldouble x = (double)rand() / RAND_MAX;\ldouble y = (double)rand() / RAND_MAX;\l"];
    B71 [label="B71\n\lif (x * x + y * y <= 1.0)\l"];
    B72 [label="B72\n\lhits=hits+1;\l"];
    B73 [label="B73\n\l\l"];
    B74 [label="B74\n\li = 0;\l"];
    B75 [label="B75\n\lif (i < 15)\l"];
    B76 [label="B76\n\lprintf(\"exp(-1) approx %.10f\\n\", taylor);\ldouble fourier = 0.0;\lint terms = 50;\l"];
    B77 [label="B77\n\li++;\l"];
    B78 [label="B78\n\ldouble term = pow(xval, i) / tgamma(i + 1);\l"];
    B79 [label="B79\n\lif (i % 2)\l"];
    B80 [label="B80\n\lterm = -term;\l"];
    B81 [label="B81\n\ltaylor += term;\l"];
    B82 [label="B82\n\li = 1;\l"];
    B83 [label="B83\n\lif (i <= terms)\l"];
    B84 [label="B84\n\lprintf(\"Fourier partial sum %.10f\\n\", fourier);\ldouble nested_sum = 0.0;\l"];
    B85 [label="B85\n\li++;\l"];
    B86 [label="B86\n\lfourier += (sin(i * 1.0) / i);\l"];
    B87 [label="B87\n\li = 1;\l"];
    B88 [label="B88\n\lif (i <= 30)\l"];
    B89 [label="B89\n\lprintf(\"Nested harmonic %.10f\\n\", nested_sum);\ldouble adaptive = 0.0;\lint intervals = 2000;\ldouble prev = 0.0;\l"];
    B90 [label="B90\n\li++;\l"];
    B91 [label="B91\n\lj = 1;\l"];
    B92 [label="B92\n\lif (j <= 30)\l"];
    B93 [label="B93\n\l\l"];
    B94 [label="B94\n\lj++;\l"];
    B95 [label="B95\n\lk = 1;\l"];
    B96 [label="B96\n\lif (k <= 30)\l"];
    B97 [label="B97\n\l\l"];
    B98 [label="B98\n\lk++;\l"];
    B99 [label="B99\n\lnested_sum += 1.0 / (i + j + k);\l"];
    B100 [label="B100\n\li = 1;\l"];
    B101 [label="B101\n\lif (i <= intervals)\l"];
    B102 [label="B102\n\ladaptive *= (b - a) / intervals;\lprintf(\"Adaptive-like %.10f\\n\", adaptive);\ldouble mat_sum = 0.0;\lint dim = 20;\ldouble mat[20][20];\l"];
    B103 [label="B103\n\li++;\l"];
    B104 [label="B104\n\ldouble xi = a + (b - a) * i / intervals;\ldouble yi = cos(xi);\ladaptive += fabs(yi - prev);\lprev = yi;\l"];
    B105 [label="B105\n\li = 0;\l"];
    B106 [label="B106\n\lif (i < dim)\l"];
    B107 [label="B107\n\li = 0;\l"];
    B108 [label="B108\n\li++;\l"];
    B109 [label="B109\n\lj = 0;\l"];
    B110 [label="B110\n\lif (j < dim)\l"];
    B111 [label="B111\n\l\l"];
    B112 [label="B112\n\lj++;\l"];
    B113 [label="B113\n\lmat[i][j] = sin((i + 1) * (j + 1));\l"];
    B114 [label="B114\n\lif (i < dim)\l"];
    B115 [label="B115\n\lprintf(\"Matrix sum %.10f\\n\", mat_sum);\lint count = 0;\ldouble seq = 0.0;\li = 0;\l"];
    B116 [label="B116\n\li++;\l"];
    B117 [label="B117\n\lj = 0;\l"];
    B118 [label="B118\n\lif (j < dim)\l"];
    B119 [label="B119\n\l\l"];
    B120 [label="B120\n\lj++;\l"];
    B121 [label="B121\n\lmat_sum += mat[i][j];\l"];
    B122 [label="B122\n\lwhile (i < 1000)\l"];
    B123 [label="B123\n\lseq /= 1000.0;\lseq *= 1.0;\lprintf(\"Pi/4 approx %.10f steps %d\\n\", seq, count);\ldouble weird = 0.0;\l"];
    B124 [label="B124\n\ldouble t = (i + 0.5) / 1000.0;\lseq += 1.0 / (1 + t * t);\li=i+1;\lcount=count+1;\l"];
    B125 [label="B125\n\li = 1;\l"];
    B126 [label="B126\n\lif (i <= 100)\l"];
    B127 [label="B127\n\lprintf(\"Weird double sum %.10f\\n\", weird);\ldouble series = 0.0;\l"];
    B128 [label="B128\n\li++;\l"];
    B129 [label="B129\n\lj = 1;\l"];
    B130 [label="B130\n\lif (j <= 100)\l"];
    B131 [label="B131\n\l\l"];
    B132 [label="B132\n\lj++;\l"];
    B133 [label="B133\n\lif ((i + j) % 2 == 0)\l"];
    B134 [label="B134\n\lweird += sin(i * j * 0.001);\l"];
    B135 [label="B135\n\l\l"];
    B136 [label="B136\n\lweird += cos(i * j * 0.001);\l"];
    B137 [label="B137\n\li = 1;\l"];
    B138 [label="B138\n\lif (i <= 100)\l"];
    B139 [label="B139\n\lprintf(\"ln(2) approx %.10f\\n\", series);\ldouble bess = 0.0;\ldouble x0 = 1.0;\l"];
    B140 [label="B140\n\li++;\l"];
    B141 [label="B141\n\ldouble term = pow(-1, i + 1) / (double)i;\lseries += term;\l"];
    B142 [label="B142\n\li = 0;\l"];
    B143 [label="B143\n\lif (i < 20)\l"];
    B144 [label="B144\n\lprintf(\"Bessel J0(1) %.10f\\n\", bess);\lreturn 0;\l"];
    B145 [label="B145\n\li++;\l"];
    B146 [label="B146\n\ldouble term = pow(-1, i) * pow(x0 / 2.0, 2 * i) / (tgamma(i + 1) * tgamma(i + 1));\lbess += term;\l"];
    B0 -> B1;
    B1 -> B2;
    B2 -> B3 [label="false"];
    B2 -> B5 [label="true"];
    B3 -> B6;
    B4 -> B2;
    B5 -> B4;
    B6 -> B7;
    B7 -> B8 [label="false"];
    B7 -> B10 [label="true"];
    B8 -> B11;
    B9 -> B7;
