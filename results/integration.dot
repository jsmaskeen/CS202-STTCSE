digraph ControlFlowGraph {
    node [shape=box, fontname="Courier"];
    edge [fontname="Helvetica"];
    B0 [label="B0\n\lprintf(\"Numerical Integration and Related Computations\\n\");\lsrand(time(NULL));\lint i = 0;\lint j = 0;\lint k = 0;\lint n = 10000;\ldouble a = 0.0, b = M_PI;\ldouble h = (b - a) / n;\ldouble rect = 0.0, trap = 0.0, simp = 0.0;\l"];
    B1 [label="B1\n\lfor (i = 0; i < n; i++)\l"];
    B2 [label="B2\n\ldouble x = a + i * h;\lrect += sin(x);\l"];
    B3 [label="B3\n\lrect *= h;\l"];
    B4 [label="B4\n\lfor (i = 0; i < n; i++)\l"];
    B5 [label="B5\n\ldouble x1 = a + i * h;\ldouble x2 = a + (i + 1) * h;\ltrap += 0.5 * (sin(x1) + sin(x2));\l"];
    B6 [label="B6\n\ltrap *= h;\l"];
    B7 [label="B7\n\lfor (i = 0; i < n; i += 2)\l"];
    B8 [label="B8\n\ldouble x0 = a + i * h;\ldouble x1 = a + (i + 1) * h;\ldouble x2 = a + (i + 2) * h;\lsimp += (sin(x0) + 4 * sin(x1) + sin(x2));\l"];
    B9 [label="B9\n\lsimp *= h / 3.0;\lprintf(\"Rect %.10f\\nTrap %.10f\\nSimp %.10f\\n\", rect, trap, simp);\ldouble monte = 0.0;\l"];
    B10 [label="B10\n\lfor (i = 0; i < n; i++)\l"];
    B11 [label="B11\n\ldouble r = a + (b - a) * (rand() / (double)RAND_MAX);\lmonte += sin(r);\l"];
    B12 [label="B12\n\lmonte *= (b - a) / n;\lprintf(\"Monte %.10f\\n\", monte);\ldouble gauss = 0.0;\lint ng = 1000;\l"];
    B13 [label="B13\n\lfor (i = 0; i < ng; i++)\l"];
    B14 [label="B14\n\ldouble t = cos(M_PI * (i + 0.75) / (ng + 0.5));\lgauss += sin(0.5 * (b - a) * t + 0.5 * (b + a));\l"];
    B15 [label="B15\n\lgauss *= (b - a) / ng;\lprintf(\"Gauss %.10f\\n\", gauss);\ldouble rom[8][8] = \{\{0.0\}\};\l"];
    B16 [label="B16\n\lfor (i = 0; i < 8; i++)\l"];
    B17 [label="B17\n\lint m = 1 << i;\ldouble step = (b - a) / m;\ldouble s = 0.5 * (sin(a) + sin(b));\l"];
    B18 [label="B18\n\lfor (j = 1; j < m; j++)\l"];
    B19 [label="B19\n\ls += sin(a + j * step);\l"];
    B20 [label="B20\n\lrom[i][0] = s * step;\l"];
    B21 [label="B21\n\lfor (i = 1; i < 8; i++)\l"];
    B22 [label="B22\n\lfor (j = 1; j <= i; j++)\l"];
    B23 [label="B23\n\lrom[i][j] = (pow(4, j) * rom[i][j - 1] - rom[i - 1][j - 1]) / (pow(4, j) - 1);\l"];
    B24 [label="B24\n\l\l"];
    B25 [label="B25\n\lprintf(\"Romberg %.10f\\n\", rom[7][7]);\ldouble integ = 0.0;\lint slices = 5000;\ldouble step = (b - a) / slices;\l"];
    B26 [label="B26\n\lfor (i = 0; i < slices; i++)\l"];
    B27 [label="B27\n\ldouble x = a + i * step + step / 2.0;\linteg += exp(-x * x);\l"];
    B28 [label="B28\n\linteg *= step;\lprintf(\"Gaussian exp(-x^2) %.10f\\n\", integ);\ldouble double_sum = 0.0;\lint m1 = 200, m2 = 200;\ldouble xa = 0, xb = 1, ya = 0, yb = 1;\ldouble hx = (xb - xa) / m1;\ldouble hy = (yb - ya) / m2;\l"];
    B29 [label="B29\n\lfor (i = 0; i < m1; i++)\l"];
    B30 [label="B30\n\lfor (j = 0; j < m2; j++)\l"];
    B31 [label="B31\n\ldouble x = xa + (i + 0.5) * hx;\ldouble y = ya + (j + 0.5) * hy;\ldouble_sum += sin(x * y);\l"];
    B32 [label="B32\n\l\l"];
    B33 [label="B33\n\ldouble_sum *= hx * hy;\lprintf(\"Double integral sin(xy) %.10f\\n\", double_sum);\ldouble volume = 0.0;\lint samples = 200000;\l"];
    B34 [label="B34\n\lfor (i = 0; i < samples; i++)\l"];
    B35 [label="B35\n\ldouble x = (double)rand() / RAND_MAX;\ldouble y = (double)rand() / RAND_MAX;\ldouble z = (double)rand() / RAND_MAX;\l"];
    B36 [label="B36\n\lif (x * x + y * y + z * z <= 1.0)\l"];
    B37 [label="B37\n\lvolume++;\l"];
    B38 [label="B38\n\l\l"];
    B39 [label="B39\n\lvolume /= samples;\lvolume *= 8.0;\lprintf(\"Sphere volume %.10f\\n\", volume);\ldouble pi_est = 0.0;\lint hits = 0;\l"];
    B40 [label="B40\n\lfor (i = 0; i < 500000; i++)\l"];
    B41 [label="B41\n\ldouble x = (double)rand() / RAND_MAX;\ldouble y = (double)rand() / RAND_MAX;\l"];
    B42 [label="B42\n\lif (x * x + y * y <= 1.0)\l"];
    B43 [label="B43\n\lhits++;\l"];
    B44 [label="B44\n\l\l"];
    B45 [label="B45\n\lpi_est = 4.0 * hits / 500000.0;\lprintf(\"Monte Pi %.10f\\n\", pi_est);\ldouble taylor = 0.0;\ldouble xval = 1.0;\l"];
    B46 [label="B46\n\lfor (i = 0; i < 15; i++)\l"];
    B47 [label="B47\n\ldouble term = pow(xval, i) / tgamma(i + 1);\l"];
    B48 [label="B48\n\lif (i % 2)\l"];
    B49 [label="B49\n\lterm = -term;\l"];
    B50 [label="B50\n\ltaylor += term;\l"];
    B51 [label="B51\n\lprintf(\"exp(-1) approx %.10f\\n\", taylor);\ldouble fourier = 0.0;\lint terms = 50;\l"];
    B52 [label="B52\n\lfor (i = 1; i <= terms; i++)\l"];
    B53 [label="B53\n\lfourier += (sin(i * 1.0) / i);\l"];
    B54 [label="B54\n\lprintf(\"Fourier partial sum %.10f\\n\", fourier);\ldouble nested_sum = 0.0;\l"];
    B55 [label="B55\n\lfor (i = 1; i <= 30; i++)\l"];
    B56 [label="B56\n\lfor (j = 1; j <= 30; j++)\l"];
    B57 [label="B57\n\lfor (k = 1; k <= 30; k++)\l"];
    B58 [label="B58\n\lnested_sum += 1.0 / (i + j + k);\l"];
    B59 [label="B59\n\l\l"];
    B60 [label="B60\n\l\l"];
    B61 [label="B61\n\lprintf(\"Nested harmonic %.10f\\n\", nested_sum);\ldouble adaptive = 0.0;\lint intervals = 2000;\ldouble prev = 0.0;\l"];
    B62 [label="B62\n\lfor (i = 1; i <= intervals; i++)\l"];
    B63 [label="B63\n\ldouble xi = a + (b - a) * i / intervals;\ldouble yi = cos(xi);\ladaptive += fabs(yi - prev);\lprev = yi;\l"];
    B64 [label="B64\n\ladaptive *= (b - a) / intervals;\lprintf(\"Adaptive-like %.10f\\n\", adaptive);\ldouble mat_sum = 0.0;\lint dim = 20;\ldouble mat[20][20];\l"];
    B65 [label="B65\n\lfor (i = 0; i < dim; i++)\l"];
    B66 [label="B66\n\lfor (j = 0; j < dim; j++)\l"];
    B67 [label="B67\n\lmat[i][j] = sin((i + 1) * (j + 1));\l"];
    B68 [label="B68\n\l\l"];
    B69 [label="B69\n\lfor (i = 0; i < dim; i++)\l"];
    B70 [label="B70\n\lfor (j = 0; j < dim; j++)\l"];
    B71 [label="B71\n\lmat_sum += mat[i][j];\l"];
    B72 [label="B72\n\l\l"];
    B73 [label="B73\n\lprintf(\"Matrix sum %.10f\\n\", mat_sum);\lint count = 0;\ldouble seq = 0.0;\li = 0;\l"];
    B74 [label="B74\n\lwhile (i < 1000)\l"];
    B75 [label="B75\n\ldouble t = (i + 0.5) / 1000.0;\lseq += 1.0 / (1 + t * t);\li++;\lcount++;\l"];
    B76 [label="B76\n\lseq /= 1000.0;\lseq *= 1.0;\lprintf(\"Pi/4 approx %.10f steps %d\\n\", seq, count);\ldouble weird = 0.0;\l"];
    B77 [label="B77\n\lfor (i = 1; i <= 100; i++)\l"];
    B78 [label="B78\n\lfor (j = 1; j <= 100; j++)\l"];
    B79 [label="B79\n\lif ((i + j) % 2 == 0)\l"];
    B80 [label="B80\n\lweird += sin(i * j * 0.001);\l"];
    B81 [label="B81\n\l\l"];
    B82 [label="B82\n\lweird += cos(i * j * 0.001);\l"];
    B83 [label="B83\n\l\l"];
    B84 [label="B84\n\lprintf(\"Weird double sum %.10f\\n\", weird);\ldouble series = 0.0;\l"];
    B85 [label="B85\n\lfor (i = 1; i <= 100; i++)\l"];
    B86 [label="B86\n\ldouble term = pow(-1, i + 1) / (double)i;\lseries += term;\l"];
    B87 [label="B87\n\lprintf(\"ln(2) approx %.10f\\n\", series);\ldouble bess = 0.0;\ldouble x0 = 1.0;\l"];
    B88 [label="B88\n\lfor (i = 0; i < 20; i++)\l"];
    B89 [label="B89\n\ldouble term = pow(-1, i) * pow(x0 / 2.0, 2 * i) / (tgamma(i + 1) * tgamma(i + 1));\lbess += term;\l"];
    B90 [label="B90\n\lprintf(\"Bessel J0(1) %.10f\\n\", bess);\lreturn 0;\l"];
    B0 -> B1;
    B1 -> B2 [label="true"];
    B1 -> B3 [label="false"];
    B2 -> B1;
    B3 -> B4;
    B4 -> B5 [label="true"];
    B4 -> B6 [label="false"];
    B5 -> B4;
    B6 -> B7;
    B7 -> B8 [label="true"];
    B7 -> B9 [label="false"];
    B8 -> B7;
    B9 -> B10;
    B10 -> B11 [label="true"];
    B10 -> B12 [label="false"];
    B11 -> B10;
    B12 -> B13;
    B13 -> B14 [label="true"];
    B13 -> B15 [label="false"];
    B14 -> B13;
