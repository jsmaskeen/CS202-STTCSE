digraph ControlFlowGraph {
    node [shape=box, fontname="Courier"];
    edge [fontname="Helvetica"];
    B0 [label="B0\n\lint i = 0;\lint x = 5;\lint y = -1;\l"];
    B1 [label="B1\n\lwhile (i < 10)\l"];
    B2 [label="B2\n\lrandom_procedure();\l"];
    B3 [label="B3\n\li = i + 1;\ly = i + x;\lprintf(\"%d\", i);\l"];
    B4 [label="B4\n\lif (i > 5)\l"];
    B5 [label="B5\n\lx = i;\lprintf(\"more than 5\");\l"];
    B6 [label="B6\n\l\l"];
    B7 [label="B7\n\lint j = 0;\l"];
    B8 [label="B8\n\lif (j < 5)\l"];
    B9 [label="B9\n\lreturn 0;\l"];
    B10 [label="B10\n\lj++;\l"];
    B11 [label="B11\n\lint z = j + y;\lprintf(\"%d\", z);\lrandom_procedure();\l"];
    B0 -> B1;
    B1 -> B2 [label="false"];
    B1 -> B3 [label="true"];
    B2 -> B7;
    B3 -> B4;
    B4 -> B5 [label="true"];
    B4 -> B6 [label="false"];
    B5 -> B6;
    B6 -> B1;
    B7 -> B8;
    B8 -> B9 [label="false"];
    B8 -> B11 [label="true"];
    B10 -> B8;
    B11 -> B10;
}