digraph ControlFlowGraph {
    node [shape=box, fontname="Courier"];
    edge [fontname="Helvetica"];
    B0 [label="B0\n\lint i = 0;\lint x = 5;\lint y = -1;\l"];
    B1 [label="B1\n\lwhile (i < 10)\l"];
    B2 [label="B2\n\li=i+1;\ly = i + x;\lprintf(\"%d\", i);\l"];
    B3 [label="B3\n\lif (i > 5)\l"];
    B4 [label="B4\n\lx = i;\lprintf(\"more than 5\");\l"];
    B5 [label="B5\n\l\l"];
    B6 [label="B6\n\lrandom_procedure();\l"];
    B7 [label="B7\n\lfor (int j = 0; j < 5; j++)\l"];
    B8 [label="B8\n\lint z = j + y;\lprintf(\"%d\", z);\lrandom_procedure();\l"];
    B9 [label="B9\n\lreturn 0;\l"];
    B0 -> B1;
    B1 -> B2 [label="true"];
    B1 -> B6 [label="false"];
    B2 -> B3;
    B3 -> B4 [label="true"];
    B3 -> B5 [label="false"];
    B4 -> B5;
    B5 -> B1;
    B6 -> B7;
    B7 -> B8 [label="true"];
    B7 -> B9 [label="false"];
    B8 -> B7;
}